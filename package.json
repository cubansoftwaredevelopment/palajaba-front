{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-spa-fallback.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-store-seo-pages.mjs && node scripts/verify-sitemap.mjs && node scripts/verify-store-seo-pages.mjs && node scripts/verify-checkout-flow.mjs",
    "sync:render-routes": "node scripts/sync-render-store-routes.mjs",
    "lint": "eslint .",
    "test:checkout": "node scripts/tests/runStoreCheckout.unit.test.mjs && node scripts/tests/marketplaceOrder.unit.test.mjs",
    "test:catalog-sort": "node scripts/tests/catalogProductSort.unit.test.mjs",
    "test:catalog-theme": "node scripts/tests/catalogThemes.unit.test.mjs",
    "test:seller-stats-trend": "node scripts/tests/sellerStatsTrend.unit.test.mjs && node scripts/tests/sellerStatsTrend.integration.test.mjs",
    "test:seller-manual-orders": "node scripts/tests/sellerManualOrder.unit.test.mjs && node scripts/tests/sellerManualOrder.integration.test.mjs",
    "test:seller-gestores": "node scripts/tests/sellerGestores.unit.test.mjs && node scripts/tests/sellerGestores.integration.test.mjs && node scripts/tests/sellerGestoresNav.unit.test.mjs && node scripts/tests/storeCheckoutPhones.unit.test.mjs",
    "test:gestor-panel": "node scripts/tests/gestorCatalog.unit.test.mjs && node scripts/tests/gestorCatalog.integration.test.mjs",
    "test:gestor-public": "node scripts/tests/gestorPublicCatalog.unit.test.mjs && node scripts/tests/gestorPublicCatalog.integration.test.mjs",
    "test:marketplace-visit": "node scripts/tests/marketplaceVisit.unit.test.mjs && node scripts/tests/marketplaceVisit.integration.test.mjs",
    "test:admin-orders": "node scripts/tests/adminOrdersAnalytics.unit.test.mjs",
    "verify:checkout-flow": "node scripts/verify-checkout-flow.mjs",
    "verify:categories": "node scripts/verify-business-categories.mjs",
    "verify:media-urls": "node scripts/verify-media-urls.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/libre-baskerville": "^5.2.10",
    "@tailwindcss/vite": "^4.3.0",
    "date-fns": "^4.3.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^2.15.4",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
